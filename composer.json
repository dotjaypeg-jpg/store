{
    "name": "chargefield/store",
    "description": "Shared store admin for Chargefield sites: orders, pricing rules and stockists (models + Filament resources).",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.2"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Chargefield\\Store\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chargefield\\Store\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chargefield\\Store\\StoreServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
